{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pmai:p0-04:srbe:v5:sanitized-result-schema:v1",
  "title": "PMAI P0-04 SRBE V5 sanitized collection result",
  "description": "Mutually exclusive sanitized SUCCESS and HOLD envelopes. SUCCESS wraps the exact operative runtime observation; HOLD includes explicit attempt-state provenance and uses a fixed conservative state for unauthenticated reviewer input. No raw provider, database, schema, credential, connection, exception, traceback, response-body, or relation value is permitted.",
  "oneOf": [
    {
      "$ref": "#/$defs/successEnvelope"
    },
    {
      "$ref": "#/$defs/holdEnvelope"
    }
  ],
  "$defs": {
    "lowercaseSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "successEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
