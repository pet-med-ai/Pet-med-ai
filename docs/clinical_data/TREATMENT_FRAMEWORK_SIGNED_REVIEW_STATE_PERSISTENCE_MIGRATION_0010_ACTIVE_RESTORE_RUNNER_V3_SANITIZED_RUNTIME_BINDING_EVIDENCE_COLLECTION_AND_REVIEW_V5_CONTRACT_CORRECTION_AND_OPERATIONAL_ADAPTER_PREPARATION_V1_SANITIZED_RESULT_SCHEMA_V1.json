    "holdEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "error_code",
        "stage_code",
        "hold",
        "attempt_state",
        "state_provenance",
        "attempt_reserved",
