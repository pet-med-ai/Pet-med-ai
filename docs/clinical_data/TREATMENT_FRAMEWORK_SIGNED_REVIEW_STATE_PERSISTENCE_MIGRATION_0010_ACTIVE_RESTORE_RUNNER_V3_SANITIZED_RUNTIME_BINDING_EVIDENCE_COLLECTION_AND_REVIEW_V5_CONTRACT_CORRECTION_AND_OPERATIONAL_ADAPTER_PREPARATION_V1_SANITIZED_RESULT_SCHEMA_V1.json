            "LIVE_PORTS_NOT_INJECTED",
            "AUTHORIZATION_INVALID",
            "AUTHORIZATION_BINDING_MISMATCH",
            "ATTEMPT_LEDGER_UNAVAILABLE",
            "LEDGER_AUTHENTICATION_FAILED",
            "ATTEMPT_ALREADY_CONSUMED",
            "ATTEMPT_LEDGER_UNCERTAIN",
            "TARGET_NOT_AVAILABLE",
            "TARGET_TOO_OLD",
            "TARGET_ATTACHMENTS_NONZERO",
            "TARGET_CONNECTIONS_NONZERO",
            "INITIAL_ALLOWLIST_NOT_EMPTY",
            "PUBLIC_ACCESS_NOT_BLOCKED",
            "IDENTITY_DOMAIN_MISMATCH",
            "IDENTITY_SEPARATION_FAILED",
            "RUNTIME_PROVENANCE_INVALID",
            "RUNTIME_PROVENANCE_UNAVAILABLE",
            "RUNTIME_COMPONENT_BINDING_MISMATCH",
            "PORT_IMPLEMENTATION_UNBOUND",
            "ALLOWLIST_ADD_FAILED",
            "ALLOWLIST_RECHECK_FAILED",
            "CONNECTION_MATERIAL_INVALID",
            "DATABASE_CONNECT_FAILED",
            "DATABASE_READONLY_CONTRACT_FAILED",
            "TLS_EVIDENCE_INVALID",
            "TLS_NEGOTIATION_INVALID",
            "FIXED_SQL_TRACE_INVALID",
            "DATABASE_OBSERVATION_INVALID",
            "SCHEMA_MANIFEST_MISMATCH",
            "DATABASE_CLOSE_FAILED",
            "ALLOWLIST_REMOVE_FAILED",
            "FINAL_ALLOWLIST_NOT_EMPTY",
            "FINAL_PUBLIC_ACCESS_NOT_BLOCKED",
            "INSTRUMENTATION_INCOMPLETE",
            "INDEPENDENT_ATTESTATION_INVALID",
            "CLEANUP_SUPERVISOR_UNAVAILABLE",
            "CLEANUP_SUPERVISOR_UNCERTAIN",
            "ANTI_ROLLBACK_WITNESS_UNAVAILABLE",
            "CLEANUP_UNCERTAIN",
            "INTERNAL_FAILURE",
            "CONTROLLED_EXECUTION_HOLD"
          ]
        },
        "stage_code": {
          "enum": [
            "PRECHECK",
            "RUNTIME_PROVENANCE",
            "ATTEMPT_RESERVATION",
            "PROVIDER_INITIAL_REVALIDATION",
            "ALLOWLIST_ADD",
            "ALLOWLIST_REVALIDATION",
            "CONNECTION_MATERIAL",
            "DATABASE_CONNECT",
            "DATABASE_READONLY_SETUP",
            "DATABASE_IDENTITY",
            "SCHEMA_MANIFEST",
            "DATABASE_CLOSE",
            "ALLOWLIST_REMOVE",
            "FINAL_NETWORK_REVALIDATION",
            "ATTEMPT_FINALIZATION",
            "CLEANUP_SUPERVISOR",
            "CLEANUP_SUPERVISOR_ARM",
            "CLEANUP_SUPERVISOR_FINALIZE",
            "INDEPENDENT_ATTESTATION",
            "ANTI_ROLLBACK_WITNESS",
            "COMPLETE",
            "OUTPUT_VALIDATION"
          ]
        },
        "hold": {
          "const": true
        },
        "attempt_state": {
          "enum": [
            "KNOWN_NOT_STARTED",
            "CONSUMED",
            "UNCERTAIN"
          ]
        },
        "state_provenance": {
          "enum": [
            "ADAPTER_STATE_MACHINE",
            "UNVERIFIED_REVIEW_INPUT"
          ]
        },
        "attempt_reserved": {
          "type": "boolean"
        },
        "collection_attempt_consumed": {
          "type": "boolean"
        },
        "cleanup_required": {
          "type": "boolean"
        },
        "cleanup_completed": {
          "type": "boolean"
        },
        "final_network_state_verified": {
          "type": "boolean"
        },
        "runtime_evidence_emitted": {
          "const": false
        },
        "raw_connection_values_disclosed": {
          "const": false
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "state_provenance"
            ],
            "properties": {
              "state_provenance": {
                "const": "UNVERIFIED_REVIEW_INPUT"
              }
            }
          },
          "then": {
            "properties": {
              "attempt_state": {
                "const": "UNCERTAIN"
              },
              "attempt_reserved": {
                "const": true
              },
              "collection_attempt_consumed": {
                "const": true
              },
              "cleanup_required": {
                "const": true
              },
              "cleanup_completed": {
                "const": false
              },
              "final_network_state_verified": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "state_provenance"
            ],
            "properties": {
              "state_provenance": {
                "const": "ADAPTER_STATE_MACHINE"
              }
            }
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "attempt_state": {
                    "const": "KNOWN_NOT_STARTED"
                  },
                  "attempt_reserved": {
                    "const": false
                  },
                  "collection_attempt_consumed": {
                    "const": false
                  },
                  "cleanup_required": {
                    "const": false
                  },
                  "cleanup_completed": {
                    "const": false
                  },
                  "final_network_state_verified": {
                    "const": false
                  }
                }
              },
              {
                "allOf": [
                  {
                    "properties": {
                      "attempt_state": {
                        "const": "CONSUMED"
                      },
                      "attempt_reserved": {
                        "const": true
                      },
                      "collection_attempt_consumed": {
                        "const": true
                      }
                    }
                  },
                  {
                    "oneOf": [
                      {
                        "properties": {
                          "cleanup_required": {
                            "const": false
                          },
                          "cleanup_completed": {
                            "const": false
                          },
                          "final_network_state_verified": {
                            "const": false
                          }
                        }
                      },
                      {
                        "properties": {
                          "cleanup_required": {
                            "const": true
                          },
                          "cleanup_completed": {
                            "const": true
                          },
                          "final_network_state_verified": {
                            "const": true
                          }
                        }
                      },
                      {
                        "properties": {
                          "cleanup_required": {
                            "const": true
                          },
                          "cleanup_completed": {
                            "const": false
                          },
                          "final_network_state_verified": {
                            "const": false
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "properties": {
                  "attempt_state": {
                    "const": "UNCERTAIN"
                  },
                  "attempt_reserved": {
                    "const": true
                  },
                  "collection_attempt_consumed": {
                    "const": true
                  },
                  "cleanup_required": {
                    "const": true
                  },
                  "cleanup_completed": {
                    "const": false
                  },
                  "final_network_state_verified": {
                    "const": false
                  }
                }
              }
            ]
          }
        }
