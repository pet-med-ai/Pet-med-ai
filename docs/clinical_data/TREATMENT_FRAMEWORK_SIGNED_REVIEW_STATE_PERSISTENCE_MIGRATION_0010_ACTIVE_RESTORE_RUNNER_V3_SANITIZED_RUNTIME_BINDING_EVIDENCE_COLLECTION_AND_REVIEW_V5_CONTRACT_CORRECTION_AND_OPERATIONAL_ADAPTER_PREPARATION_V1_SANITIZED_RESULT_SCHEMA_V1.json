        },
        "target_provider_identity_sha256": {
          "$ref": "#/$defs/lowercaseSha256"
        },
        "forbidden_production_provider_identity_sha256": {
          "$ref": "#/$defs/lowercaseSha256"
        },
        "forbidden_staging_provider_identity_sha256": {
